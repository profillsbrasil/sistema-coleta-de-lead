# =============================================================================
# WhatsApp Raffle Bot - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local na raiz do projeto e preencha os valores.
# NUNCA commite .env.local no git (já está no .gitignore por padrão do Next).
# =============================================================================

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta for Developers)
# -----------------------------------------------------------------------------

# Token de acesso permanente do System User (NÃO o token temporário do Quick Start).
# Como gerar: Business Settings → System Users → Generate Token → "Never" expire
# Permissões necessárias: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxx

# Phone Number ID do número de WhatsApp (15 dígitos).
# Onde encontrar: Meta for Developers → seu app → WhatsApp → API Setup
# NÃO confundir com o número de telefone em si (WHATSAPP_PHONE_NUMBER_ID != "5511987654321")
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# WhatsApp Business Account ID (WABA ID).
# Necessário para inscrever o app via POST /{WABA_ID}/subscribed_apps
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345

# App Secret — usado para validar HMAC dos webhooks recebidos.
# Onde: Meta for Developers → seu app → Settings → Basic → App Secret → Show
# CRÍTICO: este é o segredo usado na validação X-Hub-Signature-256
WHATSAPP_APP_SECRET=abcdef1234567890abcdef1234567890

# Verify Token — string aleatória que VOCÊ define.
# Gerar com: openssl rand -hex 32
# Use o mesmo valor no painel Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=cole-aqui-um-token-aleatorio-de-32-bytes

# Versão da Graph API (opcional).
# Default: v23.0 (atual em 2026, versão dos code samples oficiais)
# A Meta mantém versões antigas por 2 anos antes de descontinuar
WHATSAPP_API_VERSION=v23.0

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# URL pública do projeto Supabase. Vai no bundle do cliente (OK ser público).
# Onde encontrar: Supabase Dashboard → seu projeto → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Chave pública (anon). Vai no bundle do cliente (OK ser público se RLS está bem configurado).
# Onde encontrar: Supabase Dashboard → seu projeto → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de service role — BYPASSA RLS. NUNCA exponha no client.
# Use APENAS em route handlers, Server Actions e Server Components.
# Onde encontrar: Supabase Dashboard → seu projeto → Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Configuração do Evento (público, exibido na landing)
# -----------------------------------------------------------------------------

# Nome do evento que aparece na landing e nas mensagens.
NEXT_PUBLIC_EVENT_NAME=Festa Anual 2026

# Número de WhatsApp do bot em formato E.164 SEM o "+".
# Ex: Brasil = 55 (país) + 11 (DDD) + 987654321 = "5511987654321"
# Usado no link wa.me da landing.
NEXT_PUBLIC_EVENT_WHATSAPP_NUMBER=5511987654321

# (Opcional) Data do evento no formato ISO (YYYY-MM-DD).
# Útil para o cron de exclusão automática de dados pós-retenção.
EVENT_DATE=2026-06-15

# -----------------------------------------------------------------------------
# LGPD
# -----------------------------------------------------------------------------

# Versão atual dos termos. Incremente para "v2", "v3"... ao mudar o texto.
# Permite distinguir quem aceitou cada versão dos termos.
TERMS_VERSION=v1

# -----------------------------------------------------------------------------
# Segurança (Cron e endpoints administrativos)
# -----------------------------------------------------------------------------

# Token para proteger endpoints de cron (Vercel Cron envia em Authorization header).
# Gerar com: openssl rand -hex 32
# Se não usar crons, deixe vazio ou remova.
CRON_SECRET=cole-aqui-outro-token-aleatorio-diferente-do-verify

# -----------------------------------------------------------------------------
# Ambiente
# -----------------------------------------------------------------------------

# Definido automaticamente pela Vercel ("development" em dev, "production" em prod).
# Não precisa setar manualmente. Mencionado aqui para referência.
# NODE_ENV=development

# =============================================================================
# Checklist após preencher:
# =============================================================================
# [ ] Todos os campos preenchidos (não tem mais "xxxxxxxxxxxxx")
# [ ] WHATSAPP_PHONE_NUMBER_ID tem 15 dígitos
# [ ] WHATSAPP_VERIFY_TOKEN foi gerado com openssl rand
# [ ] NEXT_PUBLIC_EVENT_WHATSAPP_NUMBER sem "+" e sem hífens
# [ ] Arquivo NÃO está commitado no git (cheque com: git status)
# [ ] Mesmas variáveis também configuradas no painel da Vercel
#     (Settings → Environment Variables) antes do deploy
# =============================================================================
