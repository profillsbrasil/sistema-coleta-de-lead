{
  "name": "dashboard-leads-profills",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "lucide-react": "^1.16.0",
      "next": "^16.2.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@trpc/server": "^11.13.4",
      "@trpc/client": "^11.13.4",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "drizzle-orm": "^0.45.1",
      "@types/pg": "^8.16.0",
      "typescript": "^6.0.3",
      "dexie": "^4.4.2",
      "dexie-react-hooks": "^4.4.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @dashboard-leads-profills/db db:push",
    "db:studio": "turbo -F @dashboard-leads-profills/db db:studio",
    "db:generate": "turbo -F @dashboard-leads-profills/db db:generate",
    "db:migrate": "turbo -F @dashboard-leads-profills/db db:migrate",
    "check": "ultracite check",
    "test": "turbo test",
    "fix": "ultracite fix",
    "clean": "bash scripts/clean.sh",
    "clean-all": "bash scripts/clean.sh -y --cache",
    "clean-dry": "bash scripts/clean.sh --dry-run"
  },
  "dependencies": {
    "@dashboard-leads-profills/env": "workspace:*",
    "@dashboard-leads-profills/ui": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@dashboard-leads-profills/config": "workspace:*",
    "@types/node": "^25.9.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "~29.1.1",
    "qrcode": "^1.5.4",
    "shadcn": "^4.7.0",
    "turbo": "^2.9.14",
    "typescript": "catalog:",
    "ultracite": "7.7.0",
    "vitest": "^4.1.6",
    "web": "workspace:*"
  },
  "packageManager": "bun@1.3.11"
}
